# ==============================================================================
# HiLark Enterprise AI Assistant - Production Environment Configuration Template
# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép file này thành .env: `cp .env.production.example .env`
# 2. Điền các giá trị thực tế tương ứng với tài khoản Lark và khóa bảo mật của bạn.
# 3. Tuyệt đối KHÔNG commit file .env chứa giá trị thật lên Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH LARK OPEN PLATFORM (BẮT BUỘC)
# ------------------------------------------------------------------------------
# Lấy từ Lark Open Platform Console (https://open.larksuite.com)
app_id=cli_a1b2c3d4e5f6g7h8
app_secret=your_lark_app_secret_here
verification_token=your_verification_token_here
encrypt_key=your_encrypt_key_here
lark_domain=https://open.larksuite.com

# URL dịch vụ HiLark công khai hoặc nội bộ doanh nghiệp (phục vụ mở Webview Screen Guide)
APP_BASE_URL=http://localhost:8000
lark_oauth_redirect_uri=http://localhost:8000/auth/lark/callback

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH LARK BASE (BITABLE) - LƯU TRỮ VÀ ĐỒNG BỘ DỰ ÁN
# ------------------------------------------------------------------------------
app_token=your_lark_bitable_app_token
table_id=your_project_summary_table_id
policy_table_id=tblZphzEZPLQAy24

# ------------------------------------------------------------------------------
# 3. WEKNORA ON-PREMISE KNOWLEDGE VAULT (TRI THỨC DOANH NGHIỆP)
# ------------------------------------------------------------------------------
# Kết nối WeKnora API Server
base_url=http://host.docker.internal:8080/api/v1
api_weknora=your_weknora_admin_api_key

# WeKnora Datasets ID
dataset_id=your_knowledge_dataset_id
wiki_dataset_id=your_wiki_dataset_id
policy_dataset_id=d715d7ee-1853-4bd9-b22d-779b1ec1e28f
policy_datasource_id=c853ff6e-68c7-4767-998f-df8eb7820b1d
policy_sync_enabled=true
policy_sync_interval_seconds=3600

# WeKnora DocReader gRPC Engine (Xử lý tài liệu chuyên sâu)
DOCREADER_GRPC_HOST=host.docker.internal
DOCREADER_GRPC_PORT=50051
DOCREADER_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# 4. AI ENGINE & HYBRID BYOK (BRING YOUR OWN KEY)
# ------------------------------------------------------------------------------
# Khóa hệ thống mặc định (Dùng khi người dùng chọn chế độ 'Dùng chung hệ thống')
gemini_api=your_default_gemini_api_key
jev_api=your_jev_rerank_api_key

# Khóa bí mật mã hóa AES-256 (Dùng mã hóa API Key của User trong MongoDB)
# Tạo khóa ngẫu nhiên an toàn: openssl rand -base64 32
ENCRYPTION_SECRET_KEY=hilark-production-aes256-secret-change-me-32chars!

# ------------------------------------------------------------------------------
# 5. MONGODB INTERNAL DATABASE (CƠ SỞ DỮ LIỆU NỘI BỘ HILARK)
# ------------------------------------------------------------------------------
mongo_url=mongodb://mongodb:27017
mongo_db=LarkAssistant
mongo_memory_collection=memories
mongo_claims_collection=claims
mongo_staging_collection=conversation_staging
mongo_digest_collection=daily_digests
mongo_master_digest_collection=master_daily_digests
mongo_chat_scope_collection=chat_scopes
mongo_draft_logs_collection=draft_logs
mongo_auth_collection=lark_auth
mongo_telemetry_collection=cost_telemetry
mongo_user_settings_collection=user_settings

# ------------------------------------------------------------------------------
# 6. DAILY DIGEST, HITL & THIẾT LẬP ĐIỀU HÀNH
# ------------------------------------------------------------------------------
# Khung giờ chạy tổng hợp báo cáo ngày tự động (Giờ Việt Nam UTC+7)
digest_schedule_time=23:00
digest_approver_id=ou_your_executive_open_id_here
digest_require_approval=true

# ------------------------------------------------------------------------------
# 7. HIỆU NĂNG, BỘ ĐỆM & CONCURRENCY CONTROLS
# ------------------------------------------------------------------------------
vector_threshold=0.75
keyword_threshold=0.75
DEBOUNCE_DELAY_SECONDS=1.75
USER_COOLDOWN_SECONDS=4.0
MAX_CONCURRENT_CHAT_PIPELINES=3
CHAT_QUEUE_MAX_SIZE=100
CHAT_QUEUE_ENQUEUE_TIMEOUT=2.0

# Production runtime: setup OAuth state phải được persist bền vững, không fallback RAM.
ENVIRONMENT=production
SETUP_REQUIRE_DURABLE_STATE=true
